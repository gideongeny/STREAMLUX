rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Authenticated users can upload to their own folder (e.g. avatars)
    match /users/{userId}/{allPaths=**} {
      allow read: if true; // Profile pictures are typically public
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
